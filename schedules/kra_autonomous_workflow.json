{
  "name": "KRA Autonomous Content Creator Pipeline (SuperBots + Remotion + YouTube)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8 * * *" }
          ]
        }
      },
      "id": "cron-morning-ideation",
      "name": "08:00 AM - Jadwal Rapat Script",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/kra/schedule/1-start-script",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"topic_hint\": \"Analisis tren cerita terbaru hari ini dan buatkan script cerita ber-retensi tinggi\",\n  \"require_creator_aroll\": true\n}",
        "options": {}
      },
      "id": "http-trigger-script",
      "name": "Trigger Vito & Clara (Buat Script JSON)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 200]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 30 }
          ]
        }
      },
      "id": "cron-watcher-production",
      "name": "Setiap 30 Menit - Cek Folder Creator",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 460]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8100/kra/schedule/2-check-gate?expected_file=a_roll_raw.mp4",
        "options": {}
      },
      "id": "http-check-gate",
      "name": "Cek Status Bima (PM Gatekeeper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 460]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ready_to_produce }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-ready-to-produce",
      "name": "Apakah File Creator Siap?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/kra/schedule/3-produce-and-upload?raw_video_filename=a_roll_raw.mp4",
        "options": {}
      },
      "id": "http-trigger-remotion-youtube",
      "name": "Eksekusi Raka (Remotion+Concat) & Sora (YouTube Upload)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [960, 440]
    },
    {
      "parameters": {},
      "id": "no-op-belum-siap",
      "name": "Belum Siap - Tunggu Siklus Berikutnya",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 620]
    }
  ],
  "connections": {
    "08:00 AM - Jadwal Rapat Script": {
      "main": [[{ "node": "Trigger Vito & Clara (Buat Script JSON)", "type": "main", "index": 0 }]]
    },
    "Setiap 30 Menit - Cek Folder Creator": {
      "main": [[{ "node": "Cek Status Bima (PM Gatekeeper)", "type": "main", "index": 0 }]]
    },
    "Cek Status Bima (PM Gatekeeper)": {
      "main": [[{ "node": "Apakah File Creator Siap?", "type": "main", "index": 0 }]]
    },
    "Apakah File Creator Siap?": {
      "main": [
        [{ "node": "Eksekusi Raka (Remotion+Concat) & Sora (YouTube Upload)", "type": "main", "index": 0 }],
        [{ "node": "Belum Siap - Tunggu Siklus Berikutnya", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "timezone": "Asia/Jakarta" }
}
