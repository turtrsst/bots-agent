# --- Salin ke .env lalu isi nilainya. Jangan commit .env. ---

# ============================ LLM ============================
STUDIO_API_KEY=sk-...
# Bisa diganti endpoint OpenAI-compatible (Gemini, OpenRouter, Groq, LM Studio, dsb.)
# STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
STUDIO_MODEL=gpt-4o
STUDIO_TEMPERATURE=0.4
STUDIO_MAX_ROUNDS=40

# Folder studio (default: folder script)
# STUDIO_ROOT=/path/ke/kantor-rama-ai

# ====================== MODE OPERASI =========================
# 1 = file A-Roll dummy dibuat otomatis (CI / demo tanpa TTY)
STUDIO_MOCK_CREATOR=0
# 1 = render pakai ffmpeg asli (butuh ffmpeg di PATH + rekaman asli)
STUDIO_REAL_RENDER=0
# 1 = jangan pernah menunggu input() terminal (WAJIB untuk --daemon)
STUDIO_ASYNC_GATE=0
# Batas tunggu upload Creator dalam mode interaktif, detik (0 = tanpa batas)
STUDIO_CREATOR_TIMEOUT=0

# ========================== DAEMON ===========================
# Jadwal ideasi otomatis (jam lokal), format HH:MM dipisah koma
# STUDIO_SCHEDULE=07:00,16:00
# STUDIO_SCHEDULE_TOPIC=Riset tren konten hari ini dan pilih topik baru
# Interval polling folder input_creator/ (detik)
STUDIO_WATCH_INTERVAL=5
# File dianggap selesai di-copy bila umurnya > N detik
STUDIO_UPLOAD_SETTLE=4
# Lokasi database memori (default: <root>/workspace/studio.db)
# STUDIO_DB=/path/ke/kantor-rama-ai/workspace/studio.db

# ========================= NOTIFIKASI ========================
# auto | telegram | console | off
STUDIO_NOTIFY=auto
# Buat bot lewat @BotFather, lalu kirim /start ke bot untuk tahu chat id Anda
# (nama KRA: TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID juga diterima)
# STUDIO_TELEGRAM_TOKEN=123456:AA...
# STUDIO_TELEGRAM_CHAT_ID=123456789
# Notifikasi otomatis: naskah selesai (+ lampiran JSON) dan laporan upload (+ link YouTube/Studio)

# =============== DASHBOARD & TELEGRAM DUA ARAH ===============
# Dashboard: jalankan --serve lalu buka http://127.0.0.1:8100/
# Daftarkan webhook sekali: python virtual_office_superbots.py --set-webhook https://xxxx.ngrok-free.app/kra/telegram-webhook
# Rahasia webhook (opsional, sangat disarankan): dikirim Telegram di header
# X-Telegram-Bot-Api-Secret-Token; request tanpa header ini ditolak 403.
# STUDIO_TELEGRAM_WEBHOOK_SECRET=rahasia-panjang-anda
# Jumlah pesan chat yang disimpan untuk dashboard (default 100)
STUDIO_CHAT_LOG_LIMIT=100

# ====================== VISUAL OTOMATIS ======================
# auto | dalle | flux | pexels | gradient | off
# auto = DALL-E 3 bila ada STUDIO_IMAGE_API_KEY, lalu Flux gratis (tanpa key),
#        Pexels untuk scene visual_mode=STOCK_VIDEO, terakhir kanvas gelap FFmpeg.
STUDIO_BROLL_PROVIDER=auto
# Kunci gambar AI (OpenAI). Kosong = memakai Flux serverless gratis.
# STUDIO_IMAGE_API_KEY=sk-...
# Thumbnail YouTube 1280x720 via `npx remotion still` (1 = aktif, default)
STUDIO_THUMBNAILS=1
# Kunci Pexels (gratis di pexels.com/api) untuk stock video B-Roll
# PEXELS_API_KEY=kode-pexels-anda
# YouTube Shorts 9:16 otomatis setelah upload (1 = aktif, default 45 detik)
STUDIO_SHORTS=1
STUDIO_SHORTS_DURATION=45

# ======================= MEDIA ENGINE ========================
# Resolusi target selalu 1080p; fps & kualitas bisa diatur
STUDIO_RENDER_FPS=60
STUDIO_RENDER_CRF=20
# Model Whisper untuk subtitle otomatis: tiny | base | small | medium | large
STUDIO_WHISPER_MODEL=base
# Folder repo Remotion milik KRA + composition intro yang dipakai
# STUDIO_REMOTION_DIR=/path/ke/kantor-rama-ai/remotion_studio
# STUDIO_REMOTION_COMPOSITION=Intro
# Musik latar (dicampur -24 dB); kosongkan bila tidak ada
# STUDIO_BGM=/path/ke/musik/bgm.mp3

# ================== SUARA NARASI (FACELESS) ==================
# auto = ElevenLabs bila ada API key, kalau tidak Edge-TTS; bisa dipaksa: elevenlabs|edge|off
STUDIO_TTS_PROVIDER=auto
# ElevenLabs (opsional, premium). Kosongkan untuk memakai Edge-TTS gratis.
# STUDIO_ELEVENLABS_API_KEY=xi-...
# STUDIO_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Suara Edge-TTS bahasa Indonesia: id-ID-ArdiNeural (pria) / id-ID-GadisNeural (wanita)
STUDIO_EDGE_TTS_VOICE=id-ID-ArdiNeural
STUDIO_TTS_RATE=+5%

# Apakah pipeline menunggu rekaman Creator A-Roll?
# 1 = tunggu file di input_creator/ (default)
# 0 = mode faceless: Clara menulis narasi, Raka membuat TTS sendiri
STUDIO_REQUIRE_AROLL=1

# ==================== RISET TREN (VITO) ======================
# YouTube Data API v3 (cukup API key, tanpa OAuth) — prioritas utama
# STUDIO_YOUTUBE_API_KEY=AIza...   (alias: YOUTUBE_API_KEY)
# Tanpa key ini, radar Vito memakai yt-dlp (tanpa kuota) bila terpasang.
# Alternatif: Tavily (tren web) atau SerpAPI (hasil pencarian YouTube)
# TAVILY_API_KEY=tvly-...
# SERPAPI_API_KEY=...

# ==================== UPLOAD YOUTUBE =========================
STUDIO_YOUTUBE_CATEGORY=22
STUDIO_YOUTUBE_LANGUAGE=id
